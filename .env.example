# Copy to .env.local for development; set the same names in Vercel for
# deploys. Never commit real values.

# Activity calendar (/lab/activity): fine-grained GitHub token, public read-only.
GITHUB_TOKEN=

# Voice memos (/api/voice-memo, from the Workbench's contact panel).
# See src/features/voice-memo/README.md for the Resend setup.
# Production answers 404 unless this is 1. Development is always on.
VOICE_MEMO_ENABLED=
# Resend API key with sending access. Unset: a dry run in development
# (logged, nothing emailed), a 503 in production.
RESEND_API_KEY=
# Optional. Default: Workbench <memos@ethanaustincruse.com>
VOICE_MEMO_FROM=
# Optional. Default: contact@ethanaustincruse.com
VOICE_MEMO_TO=
